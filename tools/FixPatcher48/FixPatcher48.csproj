<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same FixPatcher (../FixPatcher/Program.cs) for .NET Framework 4.8: the binary release runs it on the user's PC
       (Windows 10/11 include .NET Framework 4.8, so no SDK is needed there). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FixPatcher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FixPatcher/Program.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
