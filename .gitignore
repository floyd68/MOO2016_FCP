# Never publish game / UCP code or binaries, decompiled sources, third-party tools or logs.
# _local_only/ is the author's local working material (originals, decompiled sources, logs, full P-code bodies).
_local_only/
build/
bin/
obj/
# JPEXS FFDec is downloaded by each user (GPL, not redistributed here)
tools/ffdec/
*.swf
*.dll
*.exe
*.orig
*.jar
# Workshop preview image (contains the game logo)
tools/workshop/preview.jpg
# SteamCMD (if unpacked into tools/): cached login, config and logs must never be committed
dumps/
tools/appcache/
tools/config/
tools/logs/
tools/package/
tools/public/
tools/siteserverui/
tools/steamapps/
tools/userdata/
tools/*.vdf
tools/steamcmd*
tools/crashhandler*
tools/*.old
tools/*.delete
tools/workshopbuilds/
